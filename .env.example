# Generate a random hex password for the Compose PostgreSQL service.
POSTGRES_PASSWORD=replace_with_random_hex
# Business settings below seed the database only on first startup. Database values win thereafter.
PUBLIC_BASE_URL=http://localhost:8080
# Optional exact additional browser origins, comma-separated. No wildcards.
ALLOWED_ORIGINS=
PORT=8080
SONIOX_API_KEY=
ASSEMBLYAI_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
RESTORE_MODE=false
MAX_UPLOAD_BYTES=2147483648
TRANSCRIPTION_CONCURRENCY=2
PREPARE_CONCURRENCY=1
# For direct Go development, also set:
# DATABASE_URL=postgres://voices:password@127.0.0.1:54329/voices?sslmode=disable
# LISTEN_ADDR=0.0.0.0:18080
# PUBLIC_BASE_URL=http://<your-lan-ip>:5173
# WEB_DIR=web/dist
# TEMP_DIR=/tmp
# DATABASE_URL_FILE / SONIOX_API_KEY_FILE /
# ASSEMBLYAI_API_KEY_FILE / LLM_API_KEY_FILE can be used instead of the corresponding variable.
