      "names": {
        "zh": {
          "preferred": "录音"
        },
        "en": {
          "preferred": "Recording"
        }
      }
    },
    {
      "id": "transcription",
      "definition": "一次转写生成的文本、时间位置与说话人标签集合。",
      "names": {
        "zh": {
          "preferred": "转写版本"
        },
        "en": {
          "preferred": "Transcription"
        }
      }
    },
    {
      "id": "speaker-label",
      "definition": "仅在一个转写版本内有效的匿名说话人标识。",
      "names": {
        "zh": {
          "preferred": "说话人标签"
        },
        "en": {
          "preferred": "Speaker label"
        }
      }
    },
    {
      "id": "person",
      "definition": "跨录音复用的真实人物信息，由用户确认与说话人标签的对应关系。",
      "names": {
        "zh": {
