        }
      }
    },
    {
      "id": "provider",
      "definition": "处理音频并生成转写结果的服务来源。",
      "names": {
        "zh": {
          "preferred": "转写服务商"
        },
        "en": {
          "preferred": "STT provider"
        }
      }
    }
  ]
