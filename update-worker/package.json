{
  "name": "voices-update-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp exec cf dev",
    "check": "vp check && vp exec tsc --noEmit",
    "test": "vp test run --config vitest.config.ts",
    "build": "vp exec cf build",
    "deploy": "vp exec cf deploy",
    "test:runtime": "vp exec cf build && vp exec node --test test/runtime.test.mjs",
    "test:quality": "vp exec node --test test/quality.test.mjs"
  },
  "dependencies": {
    "@sentry/cloudflare": "11.13.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-rc.0",
    "@cloudflare/workers-types": "^5.20261117.1",
    "@sentry/vite-plugin": "11.13.0",
    "@types/node": "^24.0.0",
    "cf": "1.0.0-rc.0",
    "miniflare": "5.20261116.0-beta",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vite-plus": "1.7.0"
  },
  "packageManager": "pnpm@12.21.0"
}
